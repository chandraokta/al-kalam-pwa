{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Al-Kalam: jalankan (port 8080)",
      "type": "shell",
      "command": "python",
      "args": ["tools/serve.py", "8080"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Al-Kalam: server saja (tanpa buka browser)",
      "type": "shell",
      "command": "python",
      "args": ["tools/serve.py", "8080", "--no-browser"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Al-Kalam: unduh font (mode offline)",
      "type": "shell",
      "command": "python",
      "args": ["tools/fetch_layout.py", "fonts"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ]
}
